# ==============================================================================
# MedSafe Flask + SQLite Production Environment Configuration
# ==============================================================================

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000
SECRET_KEY=generate_a_secure_random_hex_key_here

# Persistent SQLite Database Path
# In Docker: /app/data/medsafe.db (mounted to persistent volume)
# On Host/VM: ./data/medsafe.db
MEDSAFE_DB_PATH=/app/data/medsafe.db

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Settings
# ------------------------------------------------------------------------------
# Mode: TEST (for staging/testing) | LIVE (for real customer payments)
RAZORPAY_MODE=LIVE

# Razorpay Test Credentials (used when RAZORPAY_MODE=TEST)
RAZORPAY_TEST_KEY_ID=rzp_test_MedSafeDemoKey123
RAZORPAY_TEST_KEY_SECRET=MedSafeSecretKey2026TestMode

# Razorpay Production Live Credentials (required when RAZORPAY_MODE=LIVE)
# Generated from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_LIVE_KEY_ID=rzp_live_YOUR_PRODUCTION_KEY_ID
RAZORPAY_LIVE_KEY_SECRET=YOUR_PRODUCTION_KEY_SECRET

# Official Webhook Secret (from Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_SECRET

# Auto-capture payments at authorization time (true = auto-capture, settle to bank)
RAZORPAY_AUTO_CAPTURE=true

# ------------------------------------------------------------------------------
# Gunicorn WSGI Production Worker Tuning
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Frontend Integration
# ------------------------------------------------------------------------------
# Set to true if serving pre-built React frontend directly from Flask
SERVE_FRONTEND=false
FRONTEND_DIST=/app/frontend/dist
CORS_ORIGINS=*
