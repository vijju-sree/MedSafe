# MedSafe Environment Configuration

# Server Port
PORT=5000

# Authentication & Security
JWT_SECRET=medsafe-super-secret-jwt-key-2026
JWT_EXPIRES_IN=7d

# Clinical Adherence Rules
GRACE_PERIOD_MINUTES=30
REMINDER_INTERVAL_SECONDS=15

# Database Configuration (Optional MongoDB URI; defaults to high-performance local persistent JSON store)
# DATABASE_URL=mongodb://localhost:27017/medsafe
DATA_DIR=./data

# Email Service Configuration (Optional SMTP; defaults to built-in mock console logger)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=MedSafe Alerts <alerts@medsafe.local>

# ------------------------------------------------------------------------------
# Flask + SQLite Production Settings
# ------------------------------------------------------------------------------
FLASK_ENV=production
MEDSAFE_DB_PATH=/app/data/medsafe.db

# Razorpay Payment Gateway Mode (TEST or LIVE)
RAZORPAY_MODE=TEST
RAZORPAY_TEST_KEY_ID=rzp_test_MedSafeDemoKey123
RAZORPAY_TEST_KEY_SECRET=MedSafeSecretKey2026TestMode
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=MedSafeWebhookSecret2026
RAZORPAY_AUTO_CAPTURE=true
